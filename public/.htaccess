Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Apache + CGI/FastCGI descarta la cabecera Authorization: se conserva para el JWT.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Todo lo que no sea un archivo/carpeta real se envía al front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
